DATABASE_URL=postgresql+asyncpg://monroe:monroe@localhost:5432/monroe
SECRET_KEY=change-me-in-production-use-32-random-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
AI_PROVIDER=openai
MODEL_NAME=gpt-4o
AI_SEND_MODE=draft_only
CONFIDENCE_THRESHOLD=0.72
ALLOWED_ORIGINS=*

# Версия VK API. Токены/секреты групп хранятся в БД и добавляются через админку
# (вкладка «Группы ВК»), в env их нет.
VK_API_VERSION=5.199

# Загруженные из админки файлы лежат на сервере, в каталоге проекта.
# MEDIA_PUBLIC_URL — домен, по которому они доступны снаружи: ссылку читают и
# модель, и ВК. Пусто — ссылки относительные, только для браузера админки.
MEDIA_ROOT=data/media
MEDIA_PUBLIC_URL=https://ai.example.ru
