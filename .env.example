DATABASE_URL=postgresql+asyncpg://monroe:monroe@localhost:5432/monroe
SECRET_KEY=change-me-in-production-use-32-random-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
AI_PROVIDER=openai
MODEL_NAME=gpt-4o
AI_SEND_MODE=draft_only
CONFIDENCE_THRESHOLD=0.72
ALLOWED_ORIGINS=*

# Версия VK API. Токены/секреты групп хранятся в БД и добавляются через админку
# (вкладка «Группы ВК»), в env их нет.
VK_API_VERSION=5.199

# Bot API мессенджера MAX. Токены ботов, как и токены групп ВК, живут в БД и
# добавляются через админку (вкладка «Боты MAX»).
MAX_API_BASE=https://platform-api2.max.ru

# Каталог с корневыми сертификатами Минцифры: MAX работает по ним, в общемировых
# хранилищах этого корня нет. Без сертификатов запросы к MAX падают на проверке
# сертификата. Менять незачем — файлы лежат в репозитории (см. certs/README.md).
RU_TRUSTED_CA_DIR=certs

# Загруженные из админки файлы лежат на сервере, в каталоге проекта.
# MEDIA_PUBLIC_URL — домен, по которому они доступны снаружи: ссылку читают и
# модель, и ВК. Пусто — ссылки относительные, только для браузера админки.
MEDIA_ROOT=data/media
MEDIA_PUBLIC_URL=https://ai.example.ru

# Уведомления менеджерам о диалогах, которые ждут человека (эскалация к куратору,
# горячая стадия без ответа). Пусто — уведомления выключены, всё остальное работает.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# PANEL_PUBLIC_URL нужен ещё и ботам MAX: из него собирается адрес вебхука,
# который мы прописываем в MAX при включении бота. Только https.
PANEL_PUBLIC_URL=https://ai.example.ru
